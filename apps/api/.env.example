# Postgres — local docker-compose default shown; replace with a managed
# connection string (Neon/Supabase) in production.
DATABASE_URL=postgresql+psycopg://webdesignos:webdesignos@localhost:5432/webdesignos

# Bootstraps the first workspace + admin user — only read by
# `python -m app.core.seed`, not at request time. See docs/05_DECISIONS.md.
# Generate the hash with: python -m app.core.generate_password_hash
SEED_WORKSPACE_NAME=Default Workspace
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD_HASH=

# Random long string — used to sign session cookies. REQUIRED: the API
# refuses to start if this is blank, a placeholder, or under 32
# characters, because anyone who knows it can mint a session for any
# user. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# True in production (HTTPS only), False for local http:// dev
SESSION_COOKIE_SECURE=False

# apps/web origin(s), comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Claude API — required for the Sales Audit feature (and any future
# agent). Get a key at https://console.anthropic.com/
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# Brave Search API — optional. Used by the Sales Audit feature to check
# for public information (e.g. search visibility) beyond the business's
# own website, and by the "brave_search" Lead Discovery provider. If
# unset, the audit step is skipped rather than faked and discovery
# falls back to whichever other provider is configured.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Google Places API (New) — optional. Powers the "google_places" Lead
# Discovery provider: a real business/places source that returns
# structured name / address / suburb / state / postcode / phone /
# category / coordinates, and correctly reports businesses that have no
# website. When set, it becomes the default discovery provider (Brave
# stays available); when unset, that provider reports itself
# unavailable and discovery uses Brave.
#   1. Enable "Places API (New)" on a Google Cloud project (billing on).
#   2. Create an API key, then RESTRICT it (Console -> the key -> Edit):
#      - API restrictions -> Restrict key -> "Places API (New)" ONLY.
#      - Application restrictions -> IP addresses -> the apps/api
#        server's egress IP(s). The key is server-side only, so an IP
#        allowlist is safe; "None" is fine for local dev.
#   Docs: https://developers.google.com/maps/documentation/places/web-service/text-search
#   The key is used server-side only (integrations/places.py) — it is
#   never sent to the browser. If it's ever exposed, regenerate it in
#   the Console. Keep the real value in .env, never in a committed file.
GOOGLE_PLACES_API_KEY=

# Google Calendar — optional, per-user. Each teammate connects their own
# calendar from Settings; if unset, the "Connect Google Calendar" button
# returns a clear error instead of the app failing to start. Register an
# OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials with this redirect
# URI registered exactly, and the Calendar API enabled on the project.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/google/callback

# Encrypts the stored Google refresh token at rest — never plaintext.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Which calendar adapter meetings sync through (see
# app/integrations/calendar/registry.py). "google" (default) uses the
# real integration above. Set to "mock" for local dev/testing without a
# real Google account or OAuth setup — meeting booking/rescheduling/
# cancellation all work end to end against a synthetic, never-real
# calendar event.
CALENDAR_PROVIDER=google

# Email outreach — which provider modules/outreach/service.py dispatches
# an approved EMAIL outreach message through (see
# app/integrations/email.py). "mock" (default) never makes a network
# call — safe for local dev and tests. Set to "resend" plus an API key
# from https://resend.com/api-keys to actually send. EMAIL_FROM_ADDRESS
# must be a verified sender/domain on the Resend account.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com

# Website deployment — which provider modules/deployments/service.py
# publishes a project's generated website through (see
# app/integrations/deployment/registry.py). "mock" (default) never
# makes a network call — safe for local dev and tests, and the only
# provider actually exercised until real hosting credentials are set
# below. Set to "vercel", "netlify", "cloudflare", or "traditional" plus
# that provider's own credentials to deploy for real; each fails loudly
# rather than silently deploying through mock if its credentials are
# missing.
DEPLOY_PROVIDER=mock

# vercel — https://vercel.com/account/tokens. VERCEL_TEAM_ID only
# needed for a team-scoped token.
VERCEL_API_TOKEN=
VERCEL_PROJECT_NAME=
VERCEL_TEAM_ID=

# netlify — https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_API_TOKEN=
NETLIFY_SITE_ID=

# cloudflare pages — https://developers.cloudflare.com/fundamentals/api/get-started/create-token/
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=

# traditional hosting (FTP/FTPS) — any shared/cPanel-style host.
# TRADITIONAL_HOSTING_BASE_URL is the public site URL to report as the
# deployment's url (FTP itself never returns one), e.g.
# "https://example.com".
TRADITIONAL_HOSTING_HOST=
TRADITIONAL_HOSTING_USERNAME=
TRADITIONAL_HOSTING_PASSWORD=
TRADITIONAL_HOSTING_BASE_URL=
TRADITIONAL_HOSTING_PORT=21
TRADITIONAL_HOSTING_REMOTE_PATH=/
TRADITIONAL_HOSTING_USE_TLS=true
