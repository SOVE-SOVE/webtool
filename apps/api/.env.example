# Postgres — local docker-compose default shown; replace with a managed
# connection string (Neon/Supabase) in production.
DATABASE_URL=postgresql+psycopg://webdesignos:webdesignos@localhost:5432/webdesignos

# Single operator account — see docs/03_AGENT_RULES.md. Generate the hash
# with: python -m app.core.generate_password_hash
OPERATOR_EMAIL=you@example.com
OPERATOR_PASSWORD_HASH=

# Random long string — used to sign session cookies. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# True in production (HTTPS only), False for local http:// dev
SESSION_COOKIE_SECURE=False

# apps/web origin(s), comma-separated
ALLOWED_ORIGINS=http://localhost:3000
