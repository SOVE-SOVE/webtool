# Postgres — local docker-compose default shown; replace with a managed
# connection string (Neon/Supabase) in production.
DATABASE_URL=postgresql+psycopg://webdesignos:webdesignos@localhost:5432/webdesignos

# Bootstraps the first workspace + admin user — only read by
# `python -m app.core.seed`, not at request time. See docs/05_DECISIONS.md.
# Generate the hash with: python -m app.core.generate_password_hash
SEED_WORKSPACE_NAME=Default Workspace
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_PASSWORD_HASH=

# Random long string — used to sign session cookies. REQUIRED: the API
# refuses to start if this is blank, a placeholder, or under 32
# characters, because anyone who knows it can mint a session for any
# user. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# True in production (HTTPS only), False for local http:// dev
SESSION_COOKIE_SECURE=False

# apps/web origin(s), comma-separated
ALLOWED_ORIGINS=http://localhost:3000

# Claude API — required for the Sales Audit feature (and any future
# agent). Get a key at https://console.anthropic.com/
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# Brave Search API — optional. Used by the Sales Audit feature to check
# for public information (e.g. search visibility) beyond the business's
# own website. If unset, that step is skipped rather than faked.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Google Calendar — optional, per-user. Each teammate connects their own
# calendar from Settings; if unset, the "Connect Google Calendar" button
# returns a clear error instead of the app failing to start. Register an
# OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials with this redirect
# URI registered exactly, and the Calendar API enabled on the project.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/google/callback

# Encrypts the stored Google refresh token at rest — never plaintext.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Which calendar adapter meetings sync through (see
# app/integrations/calendar/registry.py). "google" (default) uses the
# real integration above. Set to "mock" for local dev/testing without a
# real Google account or OAuth setup — meeting booking/rescheduling/
# cancellation all work end to end against a synthetic, never-real
# calendar event.
CALENDAR_PROVIDER=google
